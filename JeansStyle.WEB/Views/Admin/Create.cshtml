@using JeansStyle.BLL.DTOs
@using JeansStyle.WEB.Models

@model ProductViewModel
@{
    Layout = "_Admin";
    ViewData["Title"] = "Product creating";
    var categories = ViewBag.Categories as List<CategoryDto>;
    var seasons = ViewBag.Seasons as List<SeasonDto>;
    var genders = ViewBag.Genders as List<GenderDto>;
}

@section Breadcrumbs
{
<li class="breadcrumb-item">Products</li>
}



<div class="main-content">
    @using (Html.BeginForm("Create", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
    {
        <div class="form-group">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="title">Title:</label>

                <input type="text" name="title" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-12 col-md-6 col-lg-3">

                <label for="price">Price:</label>
                <input type="number" min="1" max="999" name="price" />
            </div>
        </div>

        <div class="form-group">
            <div class="col-12 col-md-6 col-lg-3">

                <label>Description:</label>
                <input type="description" name="description" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="Category">Category:</label>
                @Html.DropDownListFor(model=>model.CategoryId, (IEnumerable<SelectListItem>)ViewBag.Categories)
            </div>
        </div>

        <div class="form-group">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="Season">Season:</label>
                @Html.DropDownListFor(model => model.SeasonId,  (IEnumerable<SelectListItem>)ViewBag.Seasons, new { @class = "form-control", multiple = "multiple", size = "5" })

            </div>
        </div>
        <br />
        <br />
        <div class="form-group">
            <div class="col-12 col-md-6 col-lg-3">
                <label for="Gender">Gender:</label>
                @Html.DropDownListFor(model=>model.GenderId, (IEnumerable<SelectListItem>)ViewBag.Genders)
            </div>
        </div>
        <div class="form-group">
            <div class="col-12 col-md-6 col-lg-3">
                <label>Photo:</label>
                <input name="Image" type="file" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-success">Submit</button>
        </div>
    }


    <p>
        @Html.ActionLink("Delete", "Delete") |
        @Html.ActionLink("Back to List", "GetProducts")
    </p>
</div>

@section scripts{
<script type="text/javascript">

    // Add the following code if you want the name of the file appear on select
    $(".custom-file-input").on("change", function () {
        var fileName = $(this).val().split("\\").pop();
        $(this).siblings(".custom-file-label").addClass("selected").html(fileName);
    });
</script>
}