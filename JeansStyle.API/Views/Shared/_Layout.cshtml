@model JeansStyle.API.Models.SearchRequest

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JeansStyle</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/footer.css" />
    <link rel="stylesheet" href="~/css/header.css" />
    <link rel="stylesheet" href="~/css/carousel.css" />
    <link rel="stylesheet" href="~/css/dropdown.css" />

    <script src="~/js/bootstrap.min.js"></script>
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />

    <script src="https://kit.fontawesome.com/39251c04b2.js" crossorigin="anonymous"></script>
</head>
<body>
    <header>
        <div class="nav-container">
            <a class="nav-container">
                <a class="nav-links hidden" asp-controller="Home" asp-action="Index">JeansStyle</a>
            </a>
            @using (Html.BeginForm("GetProducts", "Home", FormMethod.Get))
            {
                <div class="search-box">
                    <input class="search-txt" id="searchRequest" name="searchRequest" asp-for="Request" placeholder="Search" />
                    <button class="search-btn" type="submit" href="~/account/authorize/"><i class="fa fa-search fa-1x"></i></button>
                    <span asp-validation-summary="Request" class="text-danger"></span>
                </div>
            }
            <div class="basket">
                <i class="fa fa-shopping-cart" aria-hidden="true"></i>
            </div>
        </div>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">

                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">

                            <div class="dropdown">
                                <button class="dropbtn">Women's</button>
                                <div class="dropdown-content">
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Jeans"> Jeans</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="T-shirt"> T-shirt </a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Jacket">Jacket</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Coat"> Coat</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category=" Down Jacket"> Down Jacket</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Sport Suit"> Sport Suit</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Sweatshirt"> Sweatshirt</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Shorts"> Shorts </a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Pullover"> Pullover</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Skirt">Skirt </a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Dress">Dress </a>

                                </div>
                            </div>
                        </li>
                        <li class="nav-item">

                            <div class="dropdown">
                                <button class="dropbtn">Men's</button>
                                <div class="dropdown-content">
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Jeans"> Jeans</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="T-shirt"> T-shirt </a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Jacket">Jacket</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Coat"> Coat</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category=" Down Jacket"> Down Jacket</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Sport Suit"> Sport Suit</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Sweatshirt"> Sweatshirt</a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Shorts"> Shorts </a>
                                    <a asp-controller="Home" asp-action="GetProductByCategory" asp-route-category="Pullover"> Pullover</a>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="this-website-is-for">
            <h4>This website is for educational purposes only</h4>
            <p>
                This site displays products, that are available in our shop.
                Please, buy and be surprised by the high quality of it.
            </p>
        </div>
        <div class="travel-technology-co">
            <p>Clothes shop. Men's and women's wear.</p>
            <p>Instagram: jeans_style_kr</p>

            &copy; 2022 - JeansStyle - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>

        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
