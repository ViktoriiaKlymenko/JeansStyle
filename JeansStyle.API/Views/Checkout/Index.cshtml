@model UserCredentialsViewModel

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JeansStyle</title>
    <link rel="stylesheet/less" type="text/css" href="~/less/styles.less" />

    <script defer src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>

    <script src="https://kit.fontawesome.com/827419d714.js" crossorigin="anonymous"></script>
</head>
<div class="container">
    <form method="post" asp-action="Complete" asp-controller="UserCredentials">
        <label class="form-title"></label>
        <div asp-validation-summary="ModelOnly"></div>
        <div>
            <div>
                <input class="input-field" type="text" asp-for="FirstName" placeholder="First Name"/>
            </div>
            <span class="validation-error" asp-validation-for="FirstName"></span>
        </div>
        <div>
            <div>
                <input class="input-field" type="text" asp-for="MiddleName" placeholder="Middle Name"/>
            </div>
            <span class="validation-error" asp-validation-for="MiddleName"></span>
        </div>
        <div>
            <div>
                <input class="input-field" type="text" asp-for="LastName" placeholder="Last Name"/>
            </div>
            <span class="validation-error" asp-validation-for="LastName"></span>
        </div>
        <div>
            <div>
                <input class="input-field" type="email" asp-for="Email" placeholder="Email"/>
            </div>
            <span class="validation-error" asp-validation-for="Email"></span>
        </div>
        <div>
            <div class="phone-number-div">
                @Html.DropDownList("RegionCode", new List<SelectListItem>
                {
                    
                    new SelectListItem("US", "US"),
                    new SelectListItem("UA", "UA", selected: true)
                }, new { @onchange = "regionCodeChanged(this.value);", @class = "regioncode-dropdownlist", @id = "regionCodeSelector" })
                <input class="input-field phone-number-input" type="text" asp-for="PhoneNumber" placeholder="PhoneNumber" />
            </div>
            <span class="validation-error" asp-validation-for="PhoneNumber"></span>
            <span class="validation-error">@ViewBag.PhoneNumberErrorMessage</span>
        </div>
       
        <div>
            <div>
                <input class="submit-button" type="submit" value="Submit" />
            </div>
        </div>
    </form>
</div>

<script>
    $('.phone-number-input').mask('+(1) 999-9999999');

    function regionCodeChanged(code) {
        if (code === "US") {
            $('.phone-number-input').mask('+(1) 999-9999999');
        }
        if (code === "UA") {
            $('.phone-number-input').mask('+(380) 99-9999-999');
        }
    }
</script>
