@model JeansStyle.WEB.Models.Enums.Size
@using JeansStyle.WEB.Models.Enums
@{
    ViewData["Title"] = "Catalog";
   var sizes = ViewBag.Sizes as List<Size>;
}

<div class="main-content">
    <div class="container">
        <br>
        <br>
        @foreach (var product in ViewBag.Products)
        {
            <div class="row">
                <div class="col-md-3">
                    <div class="dress-card">
                        <div class="dress-card-head">
                            <img class="dress-card-img-top" src="@product.Image" alt="">
==
                        </div>
                        <div class="dress-card-body">
                            <h4 class="dress-card-title">@product.Title</h4>
                            <p class="dress-card-para">Made with love</p>
                            <p class="dress-card-para"><span class="dress-card-price">@Math.Round(@product.Price, 2) &#36;</span><span class="dress-card-crossed"></span><span class="dress-card-off"></span></p>

                        </div>
                    </div>
                </div>

                <div class="col-md-9">
                    <div class="description">
                        <p>Gender: @product.Gender.Name</p>
                        <p>Category: @product.Category.Name</p>
                        <div class="form-group">
             <label for="Season">Size:</label>
            @Html.DropDownListFor(model => model.Id,  (IEnumerable<SelectListItem>)ViewBag.Sizes)
        </div>
   
                        <p>Description: @product.Description</p>
                    </div>
                    <div class="row">
                        <button class="btn col-md-6 card-button" onclick="addToCookies('@product.Id')">
                            <div class="card-button-inner bag-button">Add to Bag</div>
                        </button>
                        <button class="btn col-md-6 card-button">
                            <div class="card-button-inner wish-button">Whishlist</div>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>