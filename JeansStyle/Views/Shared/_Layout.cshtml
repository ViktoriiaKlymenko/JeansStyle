@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/bundle.css" type="text/css" />
    <link rel="stylesheet" href="~/css/compiled.css" type="text/css" />
    <script src="~/lib/jquery/jquery.js"></script>
    <script src="~/lib/jquery-validate/jquery.validate.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.js"></script>
    <script src="~/lib/jquery.maskedinput/jquery.maskedinput.js"></script>
</head>
<body>
    <header>
        <div class="nav-container">
            <div class="nav-links-width hidden"></div>
            <a class="nav-container" href="@Configuration["Urls:RedirectionUrls:FrontEndSite"]">
                <img class="nav-logo" src="~/images/logo.svg" alt="AltexTravel" />
                <p class="nav-links hidden">AltexTravel</p>
            </a>
            <div class="nav-links-container nav-links-width">
                <a class="nav-links" href="~/account/authorize">@Localizer["SignIn"]</a>
                <a class="nav-links" href="~/account/register">@Localizer["SignUp"]</a>
            </div>
        </div>
    </header>
    <div class="account-form-background">
        @RenderBody()
    </div>
    <footer>
        <div class="this-website-is-for">
            <h4>This website is for demo purposes only</h4>
            <p>
                It demonstrates the functionality of AltexSoft Booking Engine – integration with GDS,
                flight search, booking and ticketing process. You cannot book real flight ticket here.
            </p>
        </div>
        <div class="travel-technology-co">
            <div>
                <img class="" src="~/images/logo.svg" alt="AltexTravel" />
                <p class="">altexsoft</p>
            </div>
            <p>Travel Technology Consulting company</p>
            <a href="https://www.altexsoft.com">altexsoft.com</a>
        </div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>